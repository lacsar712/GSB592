<svg width="1920" height="1080" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4A90E2;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#7B68EE;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#9370DB;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background gradient -->
  <rect width="1920" height="1080" fill="url(#grad1)"/>

  <!-- Mountain silhouettes -->
  <path d="M 0 800 Q 200 600 400 700 T 800 650 L 800 1080 L 0 1080 Z" fill="#2C3E50" opacity="0.6"/>
  <path d="M 400 750 Q 600 550 800 680 T 1200 620 L 1200 1080 L 400 1080 Z" fill="#34495E" opacity="0.5"/>
  <path d="M 800 700 Q 1000 500 1200 650 T 1600 600 L 1600 1080 L 800 1080 Z" fill="#2C3E50" opacity="0.7"/>
  <path d="M 1200 680 Q 1400 480 1600 620 T 1920 580 L 1920 1080 L 1200 1080 Z" fill="#34495E" opacity="0.6"/>

  <!-- Sun/Moon -->
  <circle cx="1600" cy="200" r="80" fill="#FFD700" opacity="0.8"/>

  <!-- Clouds -->
  <ellipse cx="300" cy="150" rx="100" ry="40" fill="white" opacity="0.3"/>
  <ellipse cx="350" cy="140" rx="80" ry="35" fill="white" opacity="0.3"/>
  <ellipse cx="1000" cy="200" rx="120" ry="45" fill="white" opacity="0.25"/>
  <ellipse cx="1060" cy="190" rx="90" ry="40" fill="white" opacity="0.25"/>

  <!-- Pine trees -->
  <polygon points="200,900 180,950 220,950" fill="#2E7D32" opacity="0.4"/>
  <polygon points="200,920 185,960 215,960" fill="#2E7D32" opacity="0.4"/>
  <rect x="195" y="950" width="10" height="30" fill="#5D4037" opacity="0.4"/>

  <polygon points="1500,850 1475,910 1525,910" fill="#2E7D32" opacity="0.3"/>
  <polygon points="1500,870 1480,920 1520,920" fill="#2E7D32" opacity="0.3"/>
  <rect x="1495" y="910" width="10" height="40" fill="#5D4037" opacity="0.3"/>
</svg>
